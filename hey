#!/usr/bin/env bash
# hey — attention beeps. An agent plays a short sound when it hands back to you
# (a finished reply, or a permission prompt), but ONLY if you've been idle longer
# than a threshold — so a fast back-and-forth stays silent and you're summoned
# only when you've likely stepped away. Sound only: no speech, no listening.
# Symlink onto PATH:  ln -sf <repo>/hey ~/.local/bin/hey
set -uo pipefail

# resolve own dir even when invoked through a symlink
src="${BASH_SOURCE[0]:-$0}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  [ "${src#/}" = "$src" ] && src="$dir/$src"
done
HEY_HOME="$(cd -P "$(dirname "$src")" && pwd)"
# shellcheck disable=SC1091
source "$HEY_HOME/config.sh"

usage() {
  cat <<EOF
hey — attention beeps for Claude Code agents

  hey                          list the sounds
  hey <sound> [times] [idle_s] activate for this session (previews once)
  hey off                      deactivate for this session
  hey beep <sound> [times]     play a sound now, N times (no markers)
  hey where                    show which machine the beeps will sound on

sounds: $(hey_menu | tr '\n' ' ')
defaults: times=$HEY_TIMES  idle threshold=${HEY_THRESHOLD}s
EOF
}

case "${1:-}" in
  ""|list|sounds)
    echo "sounds:"; hey_menu | sed 's/^/  /'
    echo "usage: hey <sound> [times] [idle_s]  |  hey off"; exit 0 ;;
  -h|--help) usage; exit 0 ;;
  off|stop)
    rm -f "$HEY_OUT.hey" "$HEY_OUT.turn" 2>/dev/null
    echo "hey: off for this session"; exit 0 ;;
  where)  # where will a beep actually sound? a silent misroute is the whole bug class.
    if dest="$(_hey_dest)"; then
      echo "hey: beeps sound on ${HEY_USER}@${dest} (forwarded from $(hostname -s))"
      [ -f "$HEY_KEY" ] || echo "hey: WARNING — no key at $HEY_KEY; beeps will be dropped, not played" >&2
    elif [ -n "${HEY_LOCAL:-}" ]; then
      echo "hey: beeps sound HERE ($(hostname -s)) — HEY_LOCAL=1, this is the operator's machine"
    else
      echo "hey: beeps sound HERE ($(hostname -s)) — no HEY_TARGET and no SSH origin"
      echo "hey: if you are not sitting at this machine, set HEY_TARGET in $HEY_HOME/.env" >&2
    fi
    exit 0 ;;
  beep)  # `hey beep <sound> [times]` — beep now, no markers. Also the reverse endpoint
         # (hey-play invokes us with HEY_LOCAL=1, so _hey_emit plays here and never loops).
    hey_lookup "${2:-}" >/dev/null || { echo "hey: unknown sound '${2:-}' (run 'hey')" >&2; exit 1; }
    _hey_emit "${2:-}" "${3:-1}"
    exit 0 ;;
esac

# `hey <sound> [times] [idle_s]` — activate for this session.
sound="$1"
hf="$(hey_lookup "$sound")" || { echo "hey: unknown sound '$sound' (run 'hey')" >&2; exit 1; }
[ -f "$hf" ] || { echo "hey: sound file missing: $hf" >&2; exit 1; }
times="${2:-$HEY_TIMES}"; thresh="${3:-$HEY_THRESHOLD}"
case "$times"  in ''|*[!0-9]*) echo "hey: <times> must be a whole number" >&2; exit 2 ;; esac
case "$thresh" in ''|*[!0-9]*) echo "hey: <idle_s> must be a whole number of seconds" >&2; exit 2 ;; esac
printf '%s %s %s' "$sound" "$times" "$thresh" > "$HEY_OUT.hey"
echo "hey: '$sound' ×$times after ${thresh}s idle — active for this session"
# pre-warm the reverse channel so the first remote beep isn't slow
if dest="$(_hey_dest)" && [ -f "$HEY_KEY" ]; then
  mkdir -p "$HOME/.ssh/cm" 2>/dev/null
  ( printf '' | ssh "${_hey_ssh_opts[@]}" "${HEY_USER}@${dest}" hey-warm >/dev/null 2>&1 ) &
fi
# Preview it once — routed exactly like a real beep, so activation doubles as proof
# the channel works. Previewing locally on a box the operator is not sitting at would
# be a lie: it would sound correct here and then every real beep would go missing.
_hey_emit "$sound" 1
